@model WebApplication_GestorClinico.Models.Vistas.Login
@{
    ViewData["Title"] = "Acceso Profesionales";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hospital Gestor</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <link rel="stylesheet" href="~/css/login-medico.css" />
</head>
<body>

    <partial name="_Header" />

    <div class="container d-flex align-items-center justify-content-center" style="min-height: 85vh;">
        <div class="row justify-content-center w-100">
            <div class="col-md-5">

                <div class="login-card fade-in">
                    <div class="login-header">
                        <i class="bi bi-heart-pulse-fill fs-1 mb-2"></i>
                        <h4 class="mb-0 fw-bold">Portal Médico</h4>
                        <small class="opacity-75">Acceso exclusivo para profesionales</small>
                    </div>

                    <div class="login-body">
                        <form asp-action="Login" asp-route-rolEsperado="Medico" method="post">

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

                            <div class="form-floating mb-3">
                                <input asp-for="Username" class="form-control" placeholder="Usuario" />
                                <label asp-for="Username">Matrícula o Usuario</label>
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>

                            <div class="form-floating mb-4">
                                <input asp-for="Password" class="form-control" type="password" placeholder="Contraseña" />
                                <label asp-for="Password">Contraseña</label>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="d-grid gap-2 mb-4">
                                <button type="submit" class="btn btn-primary-custom text-white rounded-pill shadow-sm">
                                    ACCEDER AL SISTEMA
                                </button>
                            </div>

                            <div class="text-center">
                                <a href="#" class="link-custom small">¿Olvidó su contraseña?</a>
                            </div>

                        </form>
                    </div>
                </div>

                <div class="text-center mt-4 text-white-50 small">
                    <p>&copy; 2025 Hospital Gestor. Área de Profesionales.</p>
                </div>

            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>