@using Microsoft.AspNetCore.Identity
@using WebApplication_GestorClinico.Context
@using WebApplication_GestorClinico.Models

@inject UserManager<IdentityUser> UserManager
@inject ClinicaDBContext Context

@{
    string nombreMostrar = User.Identity?.Name; 

    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var userId = UserManager.GetUserId(User);
        var medico = Context.Medicos.FirstOrDefault(m => m.UsuarioId == userId);

        if (medico != null)
        {
            nombreMostrar = $"{medico.Apellido}, {medico.Nombre}";
        }
    }
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Portal Médico</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/portal-medico.css" />
</head>
<body>
    <div class="top-bar">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-hospital-fill text-secondary fs-4"></i>
            <h5 class="m-0 fw-bold text-dark">Clínica Gestor</h5>
        </div>
        <div>
            <span class="me-3 small text-muted">Dr/a. <strong>@nombreMostrar</strong></span>
            <a href="@Url.Action("Logout", "Account")" class="text-danger small text-decoration-none fw-bold">Cerrar Sesión</a>
        </div>
    </div>

    <div class="main-container">
        <div class="sidebar">
            <div class="px-4 mb-2 text-uppercase small text-muted fw-bold">Menú Principal</div>

            <a href="@Url.Action("Medico", "Portal")">
                <i class="bi bi-calendar-week"></i> Agenda
            </a>

            <a href="@Url.Action("Cancelar", "Agenda")">
                <i class="bi bi-calendar-x"></i> Cancelar Agenda
            </a>

            <a href="@Url.Action("AtenderConsultorio", "Agenda")">
                <i class="bi bi-door-open"></i> Atender Consultorio
            </a>

            <a href="@Url.Action("MedicoIndex", "Guardia")">
                <i class="bi bi-bandaid"></i> Guardia
            </a>
        </div>

        <div class="content">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>